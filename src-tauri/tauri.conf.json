{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FishTools Studio",
  "version": "0.8.0",
  "identifier": "com.cutefish.studio",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "FishTools Studio",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#151b10",
        "theme": "Dark",
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-pinch --overscroll-history-navigation=0 --disable-background-timer-throttling"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ofts"
        ],
        "name": "OpenFishTools Project",
        "description": "FishTools Studio Project",
        "role": "Editor",
        "mimeType": "application/x-ofts"
      }
    ],
    "android": {
      "minSdkVersion": 29
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
